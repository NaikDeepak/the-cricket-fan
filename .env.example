# Gemini (AI story/trivia generation)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Database (asyncpg format)
DATABASE_URL=postgresql+asyncpg://cricket:cricket@localhost:5433/cricket_fan

# App
ENVIRONMENT=development
BACKEND_PORT=8000

# Frontend (Next.js public var — points to backend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Prediction bot (bot/) ---

# Neon Postgres, asyncpg format
BOT_DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname

# 1 = print tweet text to stdout instead of posting to X (no X API needed)
BOT_DRY_RUN=1

# CricAPI (fixtures/results) — https://cricapi.com
CRICKET_API_KEY=
CRICKET_API_BASE=https://api.cricapi.com/v1

# X API v2 (skip if BOT_DRY_RUN=1) — https://developer.x.com
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
